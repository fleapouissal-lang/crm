NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mot de passe PostgreSQL (Supabase → Settings → Database → Database password)
SUPABASE_DB_PASSWORD=your-database-password

# Pooler (recommandé — connexion directe db.* peut échouer sans IPv6)
# Région visible dans Supabase → Settings → Database → Connection string
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.[PROJECT_REF]

# Optionnel — URL complète (remplace SUPABASE_DB_PASSWORD)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Désactiver les migrations auto (CI sans accès DB)
# SKIP_DB_MIGRATE=true

# EasyTouch: Autolog = own session; Fusion Leap + Evana share one session
# WA_BRIDGE_URL=https://bridge.example.com
# WA_BRIDGE_SECRET=replace-me
# WA_BRIDGE_ORGANIZATION_ID=
# WA_BRIDGE_INSTANCE_ID_FUSION_LEAP=fusionleap_crm
# WA_BRIDGE_INSTANCE_ID_AUTOLOG=autolog_crm
# OUTREACH_PROVIDER=easytouch
# OUTREACH_QUALIFIED_ASSIGNEE_ID=

# AI Sales Agent (Gemini in-app, full auto) — discovery stays DuckDuckGo/OSM/IG
# GEMINI_API_KEY=
# SALES_AGENT_MODEL=gemini-2.5-flash
# SALES_AGENT_CRON_SECRET=
# Pause mass WhatsApp: only test leads can receive AI messages (default true)
# SALES_AGENT_PAUSE_OUTREACH=true
# SALES_AGENT_TEST_LEAD_IDS=uuid-optional
# SALES_AGENT_TEST_PHONES=212680961521,0680961521
# Optional — transcribe WhatsApp voice (Groq first, then OpenAI; else 1 clarify then Urgent)
# GROQ_API_KEY=
# OPENAI_API_KEY=
